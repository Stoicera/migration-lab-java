<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>at.stoicera.migrationlab</groupId>
	<artifactId>e2e</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<name>migration-lab E2E safety net</name>
	<description>Selenium suite running the same scenarios against the legacy (AngularJS)
		and modern (Angular) UI via per-target selector maps. Explicit waits only.</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>25</maven.compiler.release>
		<junit.version>5.14.4</junit.version>
		<selenium.version>4.46.0</selenium.version>
		<assertj.version>3.27.6</assertj.version>
		<postgresql.version>42.7.8</postgresql.version>
		<!-- -Dtarget=legacy|modern selects base URL, selector map and DB -->
		<target>legacy</target>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<version>${selenium.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- deterministic runs: reset DB to the committed seed before each scenario class -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>${postgresql.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<target>${target}</target>
					</systemPropertyVariables>
					<!-- scenarios are ordered flows; never run classes in parallel against one stand -->
					<forkCount>1</forkCount>
					<reuseForks>true</reuseForks>
					<!-- a run that discovers zero tests is a broken gate, not a pass (review finding 7) -->
					<failIfNoTests>true</failIfNoTests>
				</configuration>
			</plugin>
			<!-- Java format gate (google-java-format) - DEVIATIONS item
			     "Lint/Format-Check", deferred(G5), now armed; check runs at verify -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.44.5</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>1.27.0</version>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>

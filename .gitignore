# Build
target/
build/
dist/
node_modules/
# Angular toolchain (modern/frontend): CLI cache + node installed by frontend-maven-plugin
.angular/
modern/frontend/node/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war

# ai-testgen testbed workspace: the harness copies the class under evaluation here.
# The canonical, committed copies live in ai-testgen/runs/ — this directory is scratch.
ai-testgen/testbed/*/src/test/java/at/werkstatt/crm/gen/*.java

# Environment / secrets — never commit; keep .env.example current instead
.env
.env.local
.env.*.local

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Logs & temp
*.log
# …except the experiment's build logs: a COMPILE_FAILED verdict is only auditable
# with the compiler output that produced it (PROTOCOL.md §6 step 7)
!ai-testgen/runs/**/*.log
hs_err_pid*
.playwright-mcp/

# Claude Code scratch: agent worktrees created during a session (transient)
.claude/worktrees/
playbook/dist/

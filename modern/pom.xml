<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>at.werkstatt</groupId>
	<artifactId>werkstatt-crm</artifactId>
	<version>1.4.2</version>
	<!-- war -> jar at the stage-5 cutover: the JSP admin page (the only WAR
	     reason) is absorbed, src/main/webapp is gone -->
	<packaging>jar</packaging>

	<name>WerkstattCRM</name>
	<description>WerkstattCRM modern stand — grows stage by stage (see stages.md)</description>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>25</java.version>
		<!-- Ratchet: always set just below what the suite ACTUALLY reaches, then pulled up.
		     2026-07-31: 37.3 % line measured → gate 0.35 (module tests only)
		     2026-08-02: 81.3 % line / 58.3 % branch measured after adopting the repaired
		                 G6 corpus-B tests (ADR-0011) → gate 0.80, which is the first time
		                 ENGINEERING_STANDARDS §3's 80 % target is genuinely REACHED rather
		                 than declared. 1.3 points of headroom absorb jitter.
		     Never raise this above a measured value: a gate nobody can reach is the reason
		     -DskipTests exists. See docs/DEVIATIONS.md. -->
		<jacoco.line.minimum>0.80</jacoco.line.minimum>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Boot 4.1 no longer imports the Testcontainers BOM, so the version is pinned
			     here; verified live on Maven Central 2026-07-31 -->
			<dependency>
				<groupId>org.testcontainers</groupId>
				<artifactId>testcontainers-bom</artifactId>
				<version>2.0.5</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- Version pinned explicitly, overriding Boot 4.1's managed 42.7.11, because the
		     image scan armed in this very stage flagged it on its first run: CVE-2026-54291
		     (HIGH) — man-in-the-middle protection bypass via a SCRAM-SHA-256-PLUS downgrade,
		     fixed in 42.7.12. Not theoretical: PostgreSQL 18 authenticates with SCRAM, so
		     this is the mechanism the modern stand actually uses. Held at the minimum fixed
		     version rather than the newest (42.7.13) so this is a security fix and nothing
		     else — Dependabot owns routine drift.
		     Declared as a literal here AND in ai-testgen/testbed/modern/pom.xml rather than
		     as a property: PomDriftGuardTest compares DECLARED coordinates, and a property
		     override does not travel through the testbed's imported BOM the way it travels
		     through Boot's <parent>. With no version declared, the guard stayed green while
		     the two classpaths silently disagreed — measured 2026-08-05. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.12</version>
		</dependency>

		<!-- G7 (stage 6): schema management moves out of the hand-run SQL files
		     (LEGACY_NOTES wart B18) into versioned migrations that run at start.
		     TWO artifacts, and both are load-bearing — measured, not assumed:
		       - flyway-core ALONE does nothing here. Boot 4 split its
		         auto-configurations into per-technology modules, so the starter is
		         what actually wires Flyway into the context. With only flyway-core
		         the app starts happily, migrates nothing, and dies later on
		         "relation kunde does not exist" — a silent failure, not a loud one.
		       - flyway-database-postgresql is separate since Flyway 10; without it
		         Flyway starts and fails on "Unsupported Database". -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- G7 (stage 6): operability. Actuator turns the container healthcheck from
		     "the port is open" into "the app says it is ready"; the opentelemetry
		     starter adds Micrometer tracing + the OTLP exporter (traces are exported
		     only when an endpoint is configured — see application.properties). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>

		<!-- JSP/JSTL/gson: retired in stage 5 with the absorbed admin page
		     (SD-2, ADR-0004) — the app is JSP-free; WAR->JAR follows at the
		     stage-5 cutover when the last webapp/ content goes -->

		<!-- G6: the module's first tests. Two DEVIATIONS items land here —
		     ArchUnit (§3) and Testcontainers integration tests (§6). Versions
		     verified live on Maven Central 2026-07-31; Testcontainers is
		     BOM-managed by Boot 4.1. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.4.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>werkstatt-crm</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Static analysis (DEVIATIONS "Statische Analyse — §6", deferred(G7)).
			     Only Error Prone's ERROR-severity patterns fail the build: those are
			     real defects (a comparison that cannot be true, a format string that
			     will throw), not opinions. The WARNING tier is deliberately not a gate
			     — this repository keeps a God class ON PURPOSE as G6's study object,
			     and a style gate that fights the exhibit would be turned off within a
			     week, which is how gates die. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- forked, because Error Prone reaches into javac internals and the
					     add-exports flags below must reach the JVM that RUNS javac, not
					     the compilation itself -->
					<fork>true</fork>
					<compilerArgs>
						<arg>-XDcompilePolicy=simple</arg>
						<arg>--should-stop=ifError=FLOW</arg>
						<arg>-Xplugin:ErrorProne</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
						<arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
						<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
						<arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
					</compilerArgs>
					<annotationProcessorPaths>
						<path>
							<groupId>com.google.errorprone</groupId>
							<artifactId>error_prone_core</artifactId>
							<version>2.50.0</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!-- Stage 5: the Angular UI is part of this artifact. The plugin
			     installs its own Node (no local toolchain requirement, same
			     pattern as the Dockerized JDK-8 build of legacy/) and builds
			     frontend/ reproducibly via npm ci + the committed lockfile.
			     Versions verified live 2026-07-30: Node v24.18.1 LTS. -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.15.1</version>
				<configuration>
					<workingDirectory>frontend</workingDirectory>
					<installDirectory>frontend</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>v24.18.1</nodeVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm-ci</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci</arguments>
						</configuration>
					</execution>
					<execution>
						<id>ng-build</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
					<!-- lint/format gates (DEVIATIONS: deferred(G5), now armed) run
					     at verify — CI enforces them, docker package skips them -->
					<execution>
						<id>ng-lint</id>
						<phase>verify</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run lint</arguments>
						</configuration>
					</execution>
					<execution>
						<id>prettier-check</id>
						<phase>verify</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run format:check</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Coverage (DEVIATIONS "Coverage-Gate", deferred(G6) → armed here).
			     The rule is a RATCHET, not the §3 target of 80 %: it pins what the
			     module's first suite actually reaches (G6) so coverage cannot fall,
			     and is raised when the ai-testgen tests are adopted. A gate whose
			     number was never measured is decoration. Version verified 2026-07-31. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>ratchet</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>${jacoco.line.minimum}</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Java format gate (google-java-format), same deviation item;
			     spotless:check binds to verify. Versions checked 2026-07-31. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.44.5</version>
				<configuration>
					<java>
						<googleJavaFormat>
							<version>1.27.0</version>
						</googleJavaFormat>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- ship the Angular build as Boot static resources -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-frontend-dist</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
							<resources>
								<resource>
									<directory>frontend/dist/werkstatt-frontend/browser</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>

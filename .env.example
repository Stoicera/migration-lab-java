# migration-lab — environment template (ENGINEERING_STANDARDS: ".env.example gepflegt")
#
# The two dev stands need NO env file: they run on inline, honestly-labeled
# dev-only credentials (see legacy/docker-compose.yml, modern/docker-compose.yml —
# Postgres bound to 127.0.0.1). Nothing in this file is a secret; real values
# are provided per environment and never committed.
#
# Copy to .env (git-ignored) and fill in only what you need. Everything in sections 2
# and 3 is OPTIONAL — the quickstart works without any of it.

# =====================================================================
# 1. G6 ai-testgen — required only when executing the frozen PROTOCOL.md
# =====================================================================
# Create at https://openrouter.ai/keys. Copy this file to .env (git-ignored) and fill
# it in — the harness reads .env by itself, so the key never has to enter shell history.
# The full executed run (24 calls, 2026-07-31) cost EUR 0.65; the harness hard-aborts at EUR 20.
OPENROUTER_API_KEY=

# =====================================================================
# 2. Stage 6 — the reverse-proxy edge (modern/docker-compose.edge.yml)
# =====================================================================
# Only needed when you start the edge overlay. Compose REFUSES to start without
# MODERN_ADMIN_AUTH rather than falling back to a default — a demo credential that
# ships in a repository ends up in production exactly once.
#
#   MODERN_ADMIN_AUTH="admin:$(openssl passwd -apr1 'your-password')"
#
# htpasswd format, one or more users comma-separated. Mind the single quotes when you
# paste a value into a file: the hash contains $ signs.
# MODERN_ADMIN_AUTH=

# HSTS max-age in seconds. Ships as 0 (off) ON PURPOSE — sent over plain HTTP it
# teaches the browser to refuse http://localhost for a year. Set this ONLY on a host
# that terminates TLS, e.g. 31536000.
# MODERN_HSTS_SECONDS=0

# Content-Security-Policy override. The default lives in docker-compose.edge.yml and is
# strict everywhere except style-src, which needs 'unsafe-inline' because Angular
# injects component styles at runtime (measured — docs/deployment.md §12). If you change
# it, re-run modern/edge/verify-edge.sh AND look at the browser console: no automated
# check in this repository can see a CSP violation.
# MODERN_CSP=

# Rate limit per client IP (token bucket, period 1s). Defaults: 30 / 60.
# MODERN_RATELIMIT_AVERAGE=30
# MODERN_RATELIMIT_BURST=60

# =====================================================================
# 3. Stage 6 — observability (modern/docker-compose.yml, profile "observability")
# =====================================================================
# Tracing is OFF by default: with no collector configured the OTLP exporter retries
# against localhost:4318 and logs a connection failure on every batch. Switch it on
# together with the profile, never alone:
#   WERKSTATT_TRACING_ENABLED=true docker compose -f modern/docker-compose.yml \
#     --profile observability up -d --wait
# WERKSTATT_TRACING_ENABLED=false

# Where traces go. The compose file points this at the bundled collector; override it
# for an external one.
# WERKSTATT_OTLP_ENDPOINT=http://otel:4318/v1/traces

# =====================================================================
# 4. Stage 6 — application settings worth knowing before a real deployment
# =====================================================================
# Flyway locations. The default includes the demo seed; PRODUCTION MUST DROP IT, or the
# stand inserts ten fictional customers into an empty production database:
#   SPRING_FLYWAY_LOCATIONS=classpath:db/migration
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Log format. Compose sets this to "ecs" so containers emit structured JSON; unset means
# human-readable console output for a bare `java -jar`.
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# =====================================================================
# 5. Production deployment — RESERVED, NOTHING READS THESE YET
# =====================================================================
# For G7 part 2. No workflow references them today, and no repository secrets exist
# (`gh secret list` is empty), so a workflow using them would receive an empty string
# and fail at runtime rather than at lint time.
# docs/MANUAL_TASKS.md §I is the checklist for creating them.
# DOKPLOY_URL=
# DOKPLOY_TOKEN=
# GHCR_TOKEN=

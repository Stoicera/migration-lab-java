# migration-lab — environment template (ENGINEERING_STANDARDS: ".env.example gepflegt")
#
# The two dev stands need NO env file: they run on inline, honestly-labeled
# dev-only credentials (see legacy/docker-compose.yml, modern/docker-compose.yml —
# Postgres bound to 127.0.0.1). Nothing in this file is a secret; real values
# are provided per environment and never committed.

# --- G6 ai-testgen (required only when executing the frozen PROTOCOL.md) ---
OPENROUTER_API_KEY=

# --- G7 deployment (Hetzner + Dokploy; filled at G7, see docs/MILESTONES.md) ---
# DOKPLOY_URL=
# DOKPLOY_TOKEN=
# GHCR_TOKEN=

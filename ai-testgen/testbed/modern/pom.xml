<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>at.stoicera.migrationlab</groupId>
	<artifactId>testbed-modern</artifactId>
	<version>1.0.0</version>
	<packaging>jar</packaging>

	<name>ai-testgen testbed — corpus B (modern)</name>
	<description>Measurement environment for PROTOCOL.md corpus B: the identical procedure against the
		constructor-injected Boot 4.1 / Java 25 counterparts of the same six units. Compiles
		modern/src/main/java as an additional source root — WITHOUT the frontend build, so the
		measurement environment stays a backend unit-test environment. modern/pom.xml is not
		touched; the dependency block is a verbatim copy guarded by PomDriftGuardTest.</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<cut.release>25</cut.release>
		<test.release>25</test.release>
		<boot.version>4.1.0</boot.version>

		<junit.version>5.14.4</junit.version>
		<mockito.version>5.23.0</mockito.version>
		<assertj.version>3.27.7</assertj.version>
		<jacoco.version>0.8.15</jacoco.version>
		<!-- pinned, not inherited from the Maven super-POM: a measurement environment that
		     silently changes its compiler or test runner with the local Maven version is not
		     reproducible. Verified live 2026-07-31. -->
		<compiler.plugin.version>3.15.0</compiler.plugin.version>
		<surefire.plugin.version>3.5.6</surefire.plugin.version>
		<pitest.version>1.25.8</pitest.version>
		<pitest.junit5.version>1.2.3</pitest.junit5.version>

		<pit.targetClasses>at.werkstatt.crm.*</pit.targetClasses>
		<pit.targetTests>at.werkstatt.crm.gen.*</pit.targetTests>

		<!-- Phase A runs on purpose against tests that may fail: a failing generated
		     test is a measurement, not a broken build. measure.sh flips this to true. -->
		<testFailureIgnore>false</testFailureIgnore>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- === verbatim from modern/pom.xml (guarded by PomDriftGuardTest) === -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.12</version>
		</dependency>
		<!-- Added 2026-08-05 because stage 6 added them to modern/pom.xml, and the code
		     under test is whatever that module is today. PomDriftGuardTest caught the
		     divergence in CI on the first push — which is the guard working, not failing.
		     Consequence for the experiment is recorded as amendment A5 in PROTOCOL.md:
		     no recorded result changes, but a future replication of corpus B compiles
		     against a wider classpath than the 2026-07-31 run did. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-opentelemetry</artifactId>
		</dependency>
		<!-- === end verbatim block === -->

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>${assertj.version}</version>
			<scope>test</scope>
		</dependency>
		<!-- identical offer to corpus A (see testbed/legacy/pom.xml) — the corpora differ in the
		     code under test, never in the tooling handed to the model -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>add-code-under-test</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../../../modern/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>${compiler.plugin.version}</version>
				<executions>
					<execution>
						<id>default-compile</id>
						<configuration>
							<release>${cut.release}</release>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<release>${test.release}</release>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- resolves ${org.mockito:mockito-core:jar} for the surefire agent below -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<id>resolve-agent-paths</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${surefire.plugin.version}</version>
				<configuration>
					<failIfNoTests>true</failIfNoTests>
					<testFailureIgnore>${testFailureIgnore}</testFailureIgnore>
					<!-- see testbed/legacy/pom.xml -->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<exclude>at/werkstatt/crm/gen/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>${pitest.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>${pitest.junit5.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>${pit.targetClasses}</param>
					</targetClasses>
					<targetTests>
						<param>${pit.targetTests}</param>
					</targetTests>
					<outputFormats>
						<param>XML</param>
						<param>HTML</param>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
					<failWhenNoMutations>false</failWhenNoMutations>
					<!-- Phase A suites are frequently red, and PIT refuses to analyse a red
					     suite at all. Skipping the failing tests measures the mutation score
					     of the GREEN SUBSET — which is the honest reading of "what do these
					     tests actually catch". The failures stay counted in the pass rate,
					     and the report states the subset at every Phase-A number
					     (PROTOCOL.md §5/§7). -->
					<skipFailingTests>true</skipFailingTests>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>validation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<version>3.6.1</version>
						<executions>
							<execution>
								<id>add-validation-tests</id>
								<phase>generate-test-sources</phase>
								<goals>
									<goal>add-test-source</goal>
								</goals>
								<configuration>
									<sources>
										<source>${project.basedir}/../../harness-validation/modern</source>
									</sources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
			<properties>
				<pit.targetClasses>at.werkstatt.crm.*</pit.targetClasses>
				<pit.targetTests>at.werkstatt.crm.validation.*</pit.targetTests>
			</properties>
		</profile>
	</profiles>

</project>
